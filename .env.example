# LinkedIn Auto Poster - Environment Variables
# Copy to .env for local dev. Set these in Railway dashboard for production.

# -- Required --

# OpenRouter API key (get from https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...

# LinkedIn OAuth access token (w_member_social + openid + profile scopes)
LINKEDIN_ACCESS_TOKEN=AQ...

# -- Optional --

# Your LinkedIn person sub/ID - avoids an extra /v2/userinfo call each day.
# Find it: after auth, log the 'sub' field from /v2/userinfo response.
# Example: LINKEDIN_SUB=H-NTYYJGWD
LINKEDIN_SUB=

# Secret to protect the manual /trigger endpoint (any random string)
TRIGGER_SECRET=

# Optional: enables OpenAI-generated images for each post. When unset, the app
# uses the bundled scientific-diagram generator instead.
OPENAI_API_KEY=
# Optional: override the OpenAI Images API model (defaults to gpt-image-2).
OPENAI_IMAGE_MODEL=gpt-image-2

# Port (Railway injects this automatically - usually leave blank)
PORT=3000

# -- Upgrade v2.6 --

# Required to enable POST /trigger; without it manual triggers fail closed.
# TRIGGER_SECRET already appears above; set it in Railway.
# Protect manual performance imports and GET /insights.
METRICS_SECRET=

# Optional: absolute path to a mounted Railway persistent volume (e.g. /data).
# Without a persistent volume, logs/topic history/metrics may disappear on deploy.
DATA_DIR=

# Primary writing model; whitespace is trimmed.
OPENROUTER_MODEL=qwen/qwen3.6-plus
# Comma-separated fallbacks; use an empty value to disable. Max 3 distinct models total.
OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-4.5
