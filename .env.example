# LinkedIn Auto Poster - Environment Variables
# Copy to .env for local dev. Set these in Railway dashboard for production.

# -- Required --

# OpenRouter API key (get from https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...

# LinkedIn OAuth access token (w_member_social + openid + profile scopes)
LINKEDIN_ACCESS_TOKEN=AQ...

# -- Optional --

# Your LinkedIn person sub/ID - avoids an extra /v2/userinfo call each day.
# Find it: after auth, log the 'sub' field from /v2/userinfo response.
# Example: LINKEDIN_SUB=H-NTYYJGWD
LINKEDIN_SUB=

# Secret to protect the manual /trigger endpoint (any random string)
TRIGGER_SECRET=

# Port (Railway injects this automatically - usually leave blank)
PORT=3000
