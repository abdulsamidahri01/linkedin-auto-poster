{
  "name": "linkedin-auto-poster",
  "version": "2.1.0",
  "description": "Daily automated LinkedIn posting — microbiology + AI thought leadership",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "python3 -m pip install --only-binary=:all: --no-cache-dir --target /app/python-packages -r requirements.txt",
    "dev": "node --watch src/server.js",
    "test": "node src/test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "node-cron": "^3.0.3",
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
